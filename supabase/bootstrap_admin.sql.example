-- Bootstrap the FIRST SEYSES administrator.
-- 1) Create the account in Supabase Dashboard > Authentication > Users.
-- 2) Copy that user's UUID and replace the placeholder below.
-- 3) Run this statement in the SEYSES project's SQL Editor only.
-- Never commit real emails, UUIDs, passwords, or API keys to GitHub.
insert into public.user_profiles (user_id, display_name, role, active)
values ('REPLACE_WITH_AUTH_USER_UUID'::uuid, 'Administrador SEYSES', 'admin', true)
on conflict (user_id) do update
set role = 'admin', active = true, updated_at = now();
